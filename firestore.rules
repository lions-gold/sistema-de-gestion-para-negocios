            get(/databases/$(database)/documents/storeOwnerClaims/$(storeId)).data.status == 'pending_claim' &&
            get(/databases/$(database)/documents/storeOwnerClaims/$(storeId)).data.pendingOwnerUid == existing().ownerUid &&
            get(/databases/$(database)/documents/storeOwnerClaims/$(storeId)).data.ownerEmail == request.auth.token.email &&
            getAfter(/databases/$(database)/documents/storeOwnerClaims/$(storeId)).data.status == 'claimed' &&
            getAfter(/databases/$(database)/documents/storeOwnerClaims/$(storeId)).data.claimedByUid == request.auth.uid
          )
        );

      allow delete: if isValidId(storeId) && isAdmin();

      // Split Collection PII & Private Credentials: Store owner's email and SMTP/Resend settings isolated from public storefront
      match /private/{docId} {
        allow get: if isValidId(storeId) && docId in ['account', 'emailConfig'] && isVerifiedUser() && (
          isAdmin() ||
          (resource != null && existing().ownerUid == request.auth.uid) ||
          (resource == null &&
