        (
          isAdmin() ||
          (
            incoming().ownerUid == request.auth.uid &&
            getAfter(/databases/$(database)/documents/stores/$(incoming().storeId)).data.ownerUid == request.auth.uid
          )
        );
      allow update, delete: if isValidReferralCode(code) && isAdmin();
    }

    // Store Referrals Attribution Ledger
    match /referrals/{referralId} {
      allow get: if isValidId(referralId) && isVerifiedUser() && (
        isAdmin() ||
        (resource != null && (
          existing().referrerOwnerUid == request.auth.uid ||
          existing().referredOwnerUid == request.auth.uid
        ))
      );
      allow list: if isVerifiedUser() && (
        isSuperAdminEmail() ||
        resource.data.referrerOwnerUid == request.auth.uid ||
        resource.data.referredOwnerUid == request.auth.uid
      );
      allow create: if isValidId(referralId) && isVerifiedUser() &&
        isValidStoreReferral(incoming(), referralId) &&
        incoming().referredOwnerUid == request.auth.uid &&
        incoming().status == 'registered' &&
        !('rewardCouponId' in incoming()) &&
        !('rewardCouponCode' in incoming()) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        existsAfter(/databases/$(database)/documents/stores/$(incoming().referredStoreId)) &&
        getAfter(/databases/$(database)/documents/stores/$(incoming().referredStoreId)).data.ownerUid == request.auth.uid &&
        exists(/databases/$(database)/documents/referralCodes/$(incoming().referrerCode)) &&
        get(/databases/$(database)/documents/referralCodes/$(incoming().referrerCode)).data.storeId == incoming().referrerStoreId &&
        get(/databases/$(database)/documents/referralCodes/$(incoming().referrerCode)).data.ownerUid == incoming().referrerOwnerUid;
      allow update: if isValidId(referralId) && isAdmin() &&
        isValidStoreReferral(incoming(), referralId) &&
        incoming().id == existing().id &&
        incoming().referrerStoreId == existing().referrerStoreId &&
        incoming().referredStoreId == existing().referredStoreId &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(referralId) && isAdmin();
    }

    // Service Renewal Coupons Earned from Referrals
    match /coupons/{couponId} {
      allow get: if isValidId(couponId) && isVerifiedUser() && (
        isAdmin() || (resource != null && existing().ownerUid == request.auth.uid)
      );
      allow list: if isVerifiedUser() && (
        isSuperAdminEmail() || resource.data.ownerUid == request.auth.uid
      );
      allow create: if isValidId(couponId) && isAdmin() &&
        isValidReferralCoupon(incoming(), couponId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(couponId) && isVerifiedUser() &&
        isValidReferralCoupon(incoming(), couponId) &&
        incoming().id == existing().id &&
        incoming().code == existing().code &&
        incoming().storeId == existing().storeId &&
        incoming().ownerUid == existing().ownerUid &&
        incoming().discountUSD == existing().discountUSD &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().ownerUid == request.auth.uid &&
            existing().status == 'available' &&
            incoming().status == 'applied' &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'appliedPaymentId', 'updatedAt']) &&
            'appliedPaymentId' in incoming() &&
            existsAfter(/databases/$(database)/documents/subscriptionPayments/$(incoming().appliedPaymentId)) &&
            getAfter(/databases/$(database)/documents/subscriptionPayments/$(incoming().appliedPaymentId)).data.ownerUid == request.auth.uid &&
            getAfter(/databases/$(database)/documents/subscriptionPayments/$(incoming().appliedPaymentId)).data.couponId == couponId
          )
        );
      allow delete: if isValidId(couponId) && isAdmin();
    }

    // Super Admin Sent Email Logs
    match /adminEmails/{emailId} {
      allow get: if isValidId(emailId) && isAdmin();
      allow list: if isSuperAdminEmail();
      allow create: if isValidId(emailId) && isAdmin() &&
        isValidAdminEmailDispatch(incoming(), emailId) &&
        incoming().createdAt == request.time;
      allow update, delete: if isValidId(emailId) && isAdmin();
    }

    // Vector Escalation Tickets & Admin Reports (N1-N4 Protocol)
    match /vectorTickets/{ticketId} {
      allow get: if isValidId(ticketId) && isVerifiedUser() && (
        isAdmin() ||
        (resource != null && (
          existing().storeOwnerUid == request.auth.uid ||
          existing().requesterUid == request.auth.uid
        ))
      );
      allow list: if isVerifiedUser() && (
        isSuperAdminEmail() ||
        resource.data.storeOwnerUid == request.auth.uid ||
        resource.data.requesterUid == request.auth.uid
      );
      allow create: if isValidId(ticketId) && isVerifiedUser() &&
        isValidVectorTicket(incoming(), ticketId) &&
        incoming().requesterUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          incoming().storeId == 'platform' ||
          (
            exists(/databases/$(database)/documents/stores/$(incoming().storeId)) &&
            get(/databases/$(database)/documents/stores/$(incoming().storeId)).data.ownerUid == incoming().storeOwnerUid
          )
        );
      allow update: if isValidId(ticketId) && isVerifiedUser() &&
        isValidVectorTicket(incoming(), ticketId) &&
        incoming().id == existing().id &&
        incoming().storeId == existing().storeId &&
        incoming().storeOwnerUid == existing().storeOwnerUid &&
        incoming().requesterUid == existing().requesterUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().storeOwnerUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'level', 'priority', 'reEscalatedCount',
              'contextLeakReported', 'csatScore', 'dueAtMs', 'updatedAt'
            ])
          ) ||
          (
            existing().requesterUid == request.auth.uid &&
            existing().status != 'resolved' &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'summary', 'lastProposal', 'handoffPacket', 'csatScore', 'updatedAt'
            ])
          )
        );
      allow delete: if isValidId(ticketId) && isAdmin();
    }

    // Vector Persistent Opt-In / Opt-Out Consents
    match /vectorConsents/{consentId} {
      allow get: if isValidId(consentId) && isVerifiedUser() && (
        isAdmin() ||
        (resource != null && (
          existing().userUid == request.auth.uid ||
          existing().storeOwnerUid == request.auth.uid
        ))
      );
      allow list: if isVerifiedUser() && (
        isSuperAdminEmail() ||
        resource.data.userUid == request.auth.uid ||
        resource.data.storeOwnerUid == request.auth.uid
      );
      allow create: if isValidId(consentId) && isVerifiedUser() &&
        isValidVectorConsent(incoming(), consentId) &&
        (incoming().userUid == request.auth.uid || isAdmin()) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(consentId) && isVerifiedUser() &&
        isValidVectorConsent(incoming(), consentId) &&
        incoming().id == existing().id &&
        incoming().userUid == existing().userUid &&
        incoming().storeId == existing().storeId &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          existing().userUid == request.auth.uid
        );
      allow delete: if isValidId(consentId) && isAdmin();
    }

    // Vector Admin-Approved Campaigns to Store Owners
    match /vectorCampaigns/{campaignId} {
      allow get: if isValidId(campaignId) && isAdmin();
      allow list: if isSuperAdminEmail();
      allow create: if isValidId(campaignId) && isAdmin() &&
        isValidVectorCampaign(incoming(), campaignId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(campaignId) && isAdmin() &&
        isValidVectorCampaign(incoming(), campaignId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(campaignId) && isAdmin();
    }

    // Vector Conversation Control Telemetry (Containment vs Escalation Precision)
    match /vectorConversationStats/{statId} {
      allow get: if isValidId(statId) && isVerifiedUser() && (
        isAdmin() ||
        (resource != null && (
          existing().userUid == request.auth.uid ||
          existing().storeOwnerUid == request.auth.uid
        ))
      );
      allow list: if isVerifiedUser() && (
        isSuperAdminEmail() ||
        resource.data.userUid == request.auth.uid ||
        resource.data.storeOwnerUid == request.auth.uid
      );
      allow create: if isValidId(statId) && isVerifiedUser() &&
        isValidVectorConversationStat(incoming(), statId) &&
        incoming().userUid == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(statId) && isVerifiedUser() &&
        isValidVectorConversationStat(incoming(), statId) &&
        incoming().id == existing().id &&
        incoming().userUid == existing().userUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          existing().userUid == request.auth.uid ||
          existing().storeOwnerUid == request.auth.uid
        );
      allow delete: if isValidId(statId) && isAdmin();
    }

    // Per-User Isolated Language Preference (never shared across users)
    match /userPreferences/{uid} {
      allow get: if isValidId(uid) && isVerifiedUser() && request.auth.uid == uid;
      allow list: if false;
      allow create: if isValidId(uid) && isVerifiedUser() &&
        request.auth.uid == uid &&
        isValidUserLanguagePreference(incoming(), uid) &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(uid) && isVerifiedUser() &&
        request.auth.uid == uid &&
        isValidUserLanguagePreference(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(uid) && isVerifiedUser() && request.auth.uid == uid;
    }
  }
}
