           get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid)
        );
        allow list: if false;
        allow create: if isValidId(storeId) && docId in ['account', 'emailConfig'] && isVerifiedUser() &&
          incoming().updatedAt == request.time &&
          (
            (
              isAdmin() &&
              docId == 'account' &&
              isValidStorePrivateAccount(incoming(), storeId) &&
              incoming().createdAt == request.time &&
              existsAfter(/databases/$(database)/documents/stores/$(storeId))
            ) ||
            (
              incoming().ownerUid == request.auth.uid &&
              exists(/databases/$(database)/documents/stores/$(storeId)) &&
              get(/databases/$(database)/documents/stores/$(storeId)).data.ownerUid == request.auth.uid &&
