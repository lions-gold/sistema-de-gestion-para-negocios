               (incoming().ownerUid == existing().ownerUid &&
                existing().ownerUid == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly(['ownerEmail', 'updatedAt'])) ||
               (incoming().ownerUid == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly(['ownerUid', 'updatedAt']) &&
                exists(/databases/$(database)/documents/storeOwnerClaims/$(storeId)) &&
