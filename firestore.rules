rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Pillar 1: Global Default-Deny Catch-All Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidReferralCode(code) {
      return code is string && code.size() >= 4 && code.size() <= 40 && code.matches('^[A-Z0-9\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isSuperAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'empresaalhadiqainvest@gmail.com';
    }

    function isAdmin() {
      return isSuperAdminEmail() ||
        (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidSlug(slug) {
      return slug is string && slug.size() >= 2 && slug.size() <= 80 && slug.matches('^[a-z0-9\\-]+$');
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidAdminUser(data, uid) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['uid', 'email', 'role', 'createdAt']) &&
        data.uid == uid &&
        isValidId(data.uid) &&
        data.email is string && data.email.size() >= 5 && data.email.size() <= 160 &&
        data.role == 'superadmin' &&
        data.createdAt is timestamp;
    }

    function isValidPlatformBilling(data) {
      return data.keys().hasAll([
          'monthlyPriceUSD', 'bankTransfers', 'pagoMovil',
          'binancePay', 'bybitPay', 'supportWhatsapp', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'monthlyPriceUSD', 'bankTransfers', 'pagoMovil',
          'binancePay', 'bybitPay', 'supportWhatsapp',
          'warehousePosEnabled', 'referralRewardUSD', 'updatedAt'
        ]) &&
        data.monthlyPriceUSD is number && data.monthlyPriceUSD >= 1 && data.monthlyPriceUSD <= 1000 &&
        data.bankTransfers is string && data.bankTransfers.size() <= 1000 &&
        data.pagoMovil is string && data.pagoMovil.size() <= 500 &&
        data.binancePay is string && data.binancePay.size() <= 300 &&
        data.bybitPay is string && data.bybitPay.size() <= 300 &&
        data.supportWhatsapp is string && data.supportWhatsapp.size() >= 7 && data.supportWhatsapp.size() <= 40 &&
        (!('warehousePosEnabled' in data) || data.warehousePosEnabled is bool) &&
        (!('referralRewardUSD' in data) || (data.referralRewardUSD is number && data.referralRewardUSD >= 0 && data.referralRewardUSD <= 1000)) &&
        data.updatedAt is timestamp;
    }

    function isValidPlatformPaymentMethod(data, methodId) {
      return data.keys().hasAll([
          'id', 'name', 'currency', 'accountHolder', 'accountDetails', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'currency', 'accountHolder', 'accountDetails', 'instructions', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        data.id == methodId &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.currency in ['USD', 'Bs', 'USDT', 'EUR', 'Otro'] &&
        data.accountHolder is string && data.accountHolder.size() <= 120 &&
        data.accountDetails is string && data.accountDetails.size() >= 2 && data.accountDetails.size() <= 300 &&
        (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 400)) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidSalesPaymentMethod(data, methodId) {
      return data.keys().hasAll([
          'id', 'name', 'currency', 'appliesIgtf', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'name', 'currency', 'appliesIgtf', 'description', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        data.id == methodId &&
        isValidId(data.id) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.currency in ['USD', 'Bs', 'USDT', 'EUR', 'Otro'] &&
        data.appliesIgtf is bool &&
        (!('description' in data) || (data.description is string && data.description.size() <= 240)) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStorePaymentMethod(data, storeId, methodId) {
      return data.keys().hasAll([
          'id', 'storeId', 'ownerUid', 'name', 'currency',
          'accountHolder', 'accountDetails', 'appliesIgtf', 'isActive',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'ownerUid', 'name', 'currency',
          'accountHolder', 'accountDetails', 'instructions', 'appliesIgtf', 'isActive',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == methodId &&
        data.storeId == storeId &&
        isValidId(data.id) &&
        isValidId(data.storeId) &&
        isValidId(data.ownerUid) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.currency in ['USD', 'Bs', 'USDT', 'EUR', 'Otro'] &&
        data.accountHolder is string && data.accountHolder.size() <= 120 &&
        data.accountDetails is string && data.accountDetails.size() >= 2 && data.accountDetails.size() <= 300 &&
        (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 400)) &&
        data.appliesIgtf is bool &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStoreSubscriptionPaymentMethod(data, storeId, methodId) {
      return data.keys().hasAll([
          'id', 'storeId', 'storeName', 'ownerUid', 'name', 'currency',
          'accountHolder', 'accountDetails', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'storeName', 'ownerUid', 'name', 'currency',
          'accountHolder', 'accountDetails', 'instructions', 'isActive',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == methodId &&
        data.storeId == storeId &&
        isValidId(data.id) &&
        isValidId(data.storeId) &&
        data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 100 &&
        isValidId(data.ownerUid) &&
        data.name is string && data.name.size() >= 2 && data.name.size() <= 80 &&
        data.currency in ['USD', 'Bs', 'USDT', 'EUR', 'Otro'] &&
        data.accountHolder is string && data.accountHolder.size() <= 120 &&
        data.accountDetails is string && data.accountDetails.size() >= 2 && data.accountDetails.size() <= 300 &&
        (!('instructions' in data) || (data.instructions is string && data.instructions.size() <= 400)) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStoreOwnerClaim(data, claimId) {
      return data.keys().hasAll([
          'id', 'storeId', 'storeName', 'ownerName', 'ownerEmail',
          'pendingOwnerUid', 'status', 'createdByEmail', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'storeName', 'ownerName', 'ownerEmail',
          'pendingOwnerUid', 'claimedByUid', 'status', 'createdByEmail', 'createdAt', 'updatedAt'
        ]) &&
        data.id == claimId &&
        isValidId(data.id) &&
        isValidId(data.storeId) &&
        data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 100 &&
        data.ownerName is string && data.ownerName.size() >= 2 && data.ownerName.size() <= 100 &&
        data.ownerEmail is string && data.ownerEmail.size() >= 5 && data.ownerEmail.size() <= 160 &&
        isValidId(data.pendingOwnerUid) &&
        (!('claimedByUid' in data) || isValidId(data.claimedByUid)) &&
        data.status in ['pending_claim', 'claimed'] &&
        data.createdByEmail is string && data.createdByEmail.size() >= 5 && data.createdByEmail.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStoreTenant(data, storeId) {
      return data.keys().hasAll([
          'id', 'slug', 'ownerUid', 'storeName', 'registeredOwnerName',
          'businessWhatsapp', 'status', 'subscriptionPriceUSD',
          'nationalShippingEnabled', 'localDeliveryEnabled', 'pickupEnabled',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'slug', 'ownerUid', 'storeName', 'registeredOwnerName',
          'rif', 'logoUrl', 'businessWhatsapp', 'category', 'description',
          'status', 'subscriptionPriceUSD',
          'nationalShippingEnabled', 'nationalCouriers',
          'localDeliveryEnabled', 'localDeliveryFeeUSD', 'localDeliveryZone',
          'pickupEnabled', 'warehousePosEnabled',
          'referralCode', 'referredByCode', 'referredByStoreId', 'referredByStoreName', 'referralRewardGranted',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == storeId &&
        isValidId(data.id) &&
        isValidSlug(data.slug) &&
        isValidId(data.ownerUid) &&
        data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 100 &&
        data.registeredOwnerName is string && data.registeredOwnerName.size() >= 2 && data.registeredOwnerName.size() <= 100 &&
        (!('rif' in data) || (data.rif is string && data.rif.size() <= 30)) &&
        (!('logoUrl' in data) || (data.logoUrl is string && data.logoUrl.size() <= 150000)) &&
        data.businessWhatsapp is string && data.businessWhatsapp.size() >= 7 && data.businessWhatsapp.size() <= 25 &&
        (!('category' in data) || (data.category is string && data.category.size() <= 60)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
        data.status in ['pending', 'active', 'suspended'] &&
        data.subscriptionPriceUSD is number && data.subscriptionPriceUSD == 25 &&
        data.nationalShippingEnabled is bool &&
        (!('nationalCouriers' in data) || (data.nationalCouriers is string && data.nationalCouriers.size() <= 200)) &&
        data.localDeliveryEnabled is bool &&
        (!('localDeliveryFeeUSD' in data) || (data.localDeliveryFeeUSD is number && data.localDeliveryFeeUSD >= 0 && data.localDeliveryFeeUSD <= 500)) &&
        (!('localDeliveryZone' in data) || (data.localDeliveryZone is string && data.localDeliveryZone.size() <= 150)) &&
        data.pickupEnabled is bool &&
        (!('warehousePosEnabled' in data) || data.warehousePosEnabled is bool) &&
        (!('referralCode' in data) || isValidReferralCode(data.referralCode)) &&
        (!('referredByCode' in data) || isValidReferralCode(data.referredByCode)) &&
        (!('referredByStoreId' in data) || isValidId(data.referredByStoreId)) &&
        (!('referredByStoreName' in data) || (data.referredByStoreName is string && data.referredByStoreName.size() <= 100)) &&
        (!('referralRewardGranted' in data) || data.referralRewardGranted is bool) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStorePrivateAccount(data, storeId) {
      return data.keys().hasAll(['storeId', 'ownerUid', 'ownerEmail', 'createdAt', 'updatedAt']) &&
        data.keys().hasOnly(['storeId', 'ownerUid', 'ownerEmail', 'createdAt', 'updatedAt']) &&
        data.storeId == storeId &&
        isValidId(data.storeId) &&
        isValidId(data.ownerUid) &&
        data.ownerEmail is string && data.ownerEmail.size() >= 5 && data.ownerEmail.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStoreEmailConfig(data, storeId) {
      return data.keys().hasAll([
          'storeId', 'ownerUid', 'provider', 'isEnabled', 'recipientEmail',
          'alertOnCriticalStock', 'notifyOnPOS', 'notifyOnManualAdjustment', 'alertFrequency',
          'sendSalesReports', 'salesReportFrequency', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'storeId', 'ownerUid', 'provider', 'isEnabled', 'recipientEmail',
          'secondaryEmail', 'fromName', 'fromEmail', 'resendApiKey',
          'smtpHost', 'smtpPort', 'smtpSecure', 'smtpUser', 'smtpPass',
          'alertOnCriticalStock', 'notifyOnPOS', 'notifyOnManualAdjustment', 'alertFrequency',
          'sendSalesReports', 'salesReportFrequency',
          'lastTestStatus', 'lastTestAt', 'updatedAt'
        ]) &&
        data.storeId == storeId &&
        isValidId(data.storeId) &&
        isValidId(data.ownerUid) &&
        data.provider in ['resend', 'smtp'] &&
        data.isEnabled is bool &&
        data.recipientEmail is string && data.recipientEmail.size() >= 5 && data.recipientEmail.size() <= 160 &&
        (!('secondaryEmail' in data) || (data.secondaryEmail is string && data.secondaryEmail.size() <= 160)) &&
        (!('fromName' in data) || (data.fromName is string && data.fromName.size() <= 100)) &&
        (!('fromEmail' in data) || (data.fromEmail is string && data.fromEmail.size() <= 160)) &&
        (!('resendApiKey' in data) || (data.resendApiKey is string && data.resendApiKey.size() <= 300)) &&
        (!('smtpHost' in data) || (data.smtpHost is string && data.smtpHost.size() <= 160)) &&
        (!('smtpPort' in data) || (data.smtpPort is number && data.smtpPort >= 1 && data.smtpPort <= 65535)) &&
        (!('smtpSecure' in data) || data.smtpSecure is bool) &&
        (!('smtpUser' in data) || (data.smtpUser is string && data.smtpUser.size() <= 160)) &&
        (!('smtpPass' in data) || (data.smtpPass is string && data.smtpPass.size() <= 300)) &&
        data.alertOnCriticalStock is bool &&
        data.notifyOnPOS is bool &&
        data.notifyOnManualAdjustment is bool &&
        data.alertFrequency in ['immediate', 'daily'] &&
        data.sendSalesReports is bool &&
        data.salesReportFrequency in ['per_sale', 'daily_closing', 'manual'] &&
        (!('lastTestStatus' in data) || (data.lastTestStatus is string && data.lastTestStatus.size() <= 240)) &&
        (!('lastTestAt' in data) || (data.lastTestAt is string && data.lastTestAt.size() <= 60)) &&
        data.updatedAt is timestamp;
    }

    function isValidSubscriptionPayment(data, paymentId) {
      return data.keys().hasAll([
          'id', 'storeId', 'storeName', 'ownerUid', 'ownerEmail',
          'amountUSD', 'paymentMethod', 'referenceNumber', 'status',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'storeName', 'ownerUid', 'ownerEmail', 'ownerWhatsapp',
          'amountUSD', 'paymentMethod', 'referenceNumber', 'payerInfo', 'notes', 'proofImageUrl',
          'couponId', 'couponCode', 'discountUSD',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.id == paymentId &&
        isValidId(data.id) &&
        isValidId(data.storeId) &&
        data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 100 &&
        isValidId(data.ownerUid) &&
        data.ownerEmail is string && data.ownerEmail.size() >= 5 && data.ownerEmail.size() <= 160 &&
        (!('ownerWhatsapp' in data) || (data.ownerWhatsapp is string && data.ownerWhatsapp.size() <= 30)) &&
        data.amountUSD is number && data.amountUSD >= 0 && data.amountUSD <= 1000 &&
        data.paymentMethod is string && data.paymentMethod.size() >= 2 && data.paymentMethod.size() <= 80 &&
        data.referenceNumber is string && data.referenceNumber.size() >= 4 && data.referenceNumber.size() <= 80 &&
        (!('payerInfo' in data) || (data.payerInfo is string && data.payerInfo.size() <= 120)) &&
        (!('notes' in data) || (data.notes is string && data.notes.size() <= 400)) &&
        (!('proofImageUrl' in data) || (data.proofImageUrl is string && data.proofImageUrl.size() <= 150000)) &&
        (!('couponId' in data) || isValidId(data.couponId)) &&
        (!('couponCode' in data) || isValidReferralCode(data.couponCode)) &&
        (!('discountUSD' in data) || (data.discountUSD is number && data.discountUSD >= 0 && data.discountUSD <= 1000)) &&
        data.status in ['pending', 'approved', 'rejected'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStoreProduct(data, storeId, productId) {
      return data.keys().hasAll([
          'id', 'storeId', 'ownerUid', 'name', 'description',
          'priceUSD', 'rating', 'stock', 'isActive', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'ownerUid', 'name', 'description',
          'priceUSD', 'costUSD', 'rating', 'reviewCount', 'imageUrl',
          'category', 'sku', 'stock', 'minStock', 'unit',
          'isActive', 'createdAt', 'updatedAt'
        ]) &&
        data.id == productId &&
        isValidId(data.id) &&
        data.storeId == storeId &&
        isValidId(data.storeId) &&
        isValidId(data.ownerUid) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
        data.description is string && data.description.size() <= 1000 &&
        data.priceUSD is number && data.priceUSD >= 0 && data.priceUSD <= 1000000 &&
        (!('costUSD' in data) || (data.costUSD is number && data.costUSD >= 0 && data.costUSD <= 1000000)) &&
        data.rating is number && data.rating >= 1 && data.rating <= 5 &&
        (!('reviewCount' in data) || (data.reviewCount is number && data.reviewCount >= 0 && data.reviewCount <= 1000000)) &&
        (!('imageUrl' in data) || (data.imageUrl is string && data.imageUrl.size() <= 150000)) &&
        (!('category' in data) || (data.category is string && data.category.size() <= 60)) &&
        (!('sku' in data) || (data.sku is string && data.sku.size() <= 60)) &&
        data.stock is number && data.stock >= 0 && data.stock <= 1000000 &&
        (!('minStock' in data) || (data.minStock is number && data.minStock >= 0 && data.minStock <= 1000000)) &&
        (!('unit' in data) || (data.unit is string && data.unit.size() <= 30)) &&
        data.isActive is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStoreOrder(data, storeId, orderId) {
      return data.keys().hasAll([
          'id', 'storeId', 'storeOwnerUid', 'customerUid', 'invoiceNumber',
          'customerName', 'customerPhone', 'shippingType', 'shippingFeeUSD',
          'paymentMethod', 'subtotalUSD', 'totalUSD', 'totalBs', 'exchangeRate',
          'itemsSummary', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'storeOwnerUid', 'customerUid', 'invoiceNumber',
          'customerName', 'customerRif', 'customerPhone', 'customerEmail',
          'shippingType', 'shippingDetails', 'shippingFeeUSD',
          'paymentMethod', 'subtotalUSD', 'totalUSD', 'totalBs', 'exchangeRate',
          'itemsSummary', 'itemsCount', 'estimatedCostUSD', 'estimatedProfitUSD',
          'stockDeducted', 'saleChannel', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.id == orderId &&
        isValidId(data.id) &&
        data.storeId == storeId &&
        isValidId(data.storeId) &&
        isValidId(data.storeOwnerUid) &&
        isValidId(data.customerUid) &&
        data.invoiceNumber is string && data.invoiceNumber.size() >= 3 && data.invoiceNumber.size() <= 40 &&
        data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100 &&
        (!('customerRif' in data) || (data.customerRif is string && data.customerRif.size() <= 30)) &&
        data.customerPhone is string && data.customerPhone.size() >= 7 && data.customerPhone.size() <= 25 &&
        (!('customerEmail' in data) || (data.customerEmail is string && data.customerEmail.size() <= 160)) &&
        data.shippingType in ['Envío Nacional', 'Delivery Local', 'Retiro en Tienda'] &&
        (!('shippingDetails' in data) || (data.shippingDetails is string && data.shippingDetails.size() <= 300)) &&
        data.shippingFeeUSD is number && data.shippingFeeUSD >= 0 && data.shippingFeeUSD <= 1000 &&
        data.paymentMethod is string && data.paymentMethod.size() >= 2 && data.paymentMethod.size() <= 60 &&
        data.subtotalUSD is number && data.subtotalUSD >= 0 && data.subtotalUSD <= 1000000 &&
        data.totalUSD is number && data.totalUSD >= 0 && data.totalUSD <= 1000000 &&
        data.totalBs is number && data.totalBs >= 0 && data.totalBs <= 1000000000 &&
        data.exchangeRate is number && data.exchangeRate > 0 && data.exchangeRate <= 1000000 &&
        data.itemsSummary is string && data.itemsSummary.size() >= 1 && data.itemsSummary.size() <= 2000 &&
        (!('itemsCount' in data) || (data.itemsCount is number && data.itemsCount >= 1 && data.itemsCount <= 100000)) &&
        (!('estimatedCostUSD' in data) || (data.estimatedCostUSD is number && data.estimatedCostUSD >= 0 && data.estimatedCostUSD <= 1000000)) &&
        (!('estimatedProfitUSD' in data) || (data.estimatedProfitUSD is number && data.estimatedProfitUSD >= -1000000 && data.estimatedProfitUSD <= 1000000)) &&
        (!('stockDeducted' in data) || data.stockDeducted is bool) &&
        (!('saleChannel' in data) || data.saleChannel in ['Carrito Web', 'Venta Directa Tienda']) &&
        data.status in ['pending', 'confirmed', 'shipped', 'completed', 'cancelled'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidStoreOrderItem(data, storeId, orderId, itemId) {
      return data.keys().hasAll([
          'id', 'orderId', 'storeId', 'storeOwnerUid', 'customerUid',
          'productId', 'productName', 'quantity', 'unitPriceUSD', 'subtotalUSD'
        ]) &&
        data.keys().hasOnly([
          'id', 'orderId', 'storeId', 'storeOwnerUid', 'customerUid',
          'productId', 'productName', 'sku', 'unit',
          'quantity', 'unitPriceUSD', 'unitCostUSD', 'subtotalUSD'
        ]) &&
        data.id == itemId &&
        isValidId(data.id) &&
        data.orderId == orderId &&
        isValidId(data.orderId) &&
        data.storeId == storeId &&
        isValidId(data.storeId) &&
        isValidId(data.storeOwnerUid) &&
        isValidId(data.customerUid) &&
        isValidId(data.productId) &&
        data.productName is string && data.productName.size() >= 1 && data.productName.size() <= 140 &&
        (!('sku' in data) || (data.sku is string && data.sku.size() <= 60)) &&
        (!('unit' in data) || (data.unit is string && data.unit.size() <= 30)) &&
        data.quantity is number && data.quantity > 0 && data.quantity <= 100000 &&
        data.unitPriceUSD is number && data.unitPriceUSD >= 0 && data.unitPriceUSD <= 1000000 &&
        (!('unitCostUSD' in data) || (data.unitCostUSD is number && data.unitCostUSD >= 0 && data.unitCostUSD <= 1000000)) &&
        data.subtotalUSD is number && data.subtotalUSD >= 0 && data.subtotalUSD <= 1000000;
    }

    function isValidReferralCodeLookup(data, code) {
      return data.keys().hasAll(['code', 'storeId', 'storeName', 'ownerUid', 'createdAt']) &&
        data.keys().hasOnly(['code', 'storeId', 'storeName', 'ownerUid', 'createdAt']) &&
        data.code == code &&
        isValidReferralCode(data.code) &&
        isValidId(data.storeId) &&
        data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 100 &&
        isValidId(data.ownerUid) &&
        data.createdAt is timestamp;
    }

    function isValidStoreReferral(data, referralId) {
      return data.keys().hasAll([
          'id', 'referrerStoreId', 'referrerStoreName', 'referrerOwnerUid', 'referrerCode',
          'referredStoreId', 'referredStoreName', 'referredOwnerUid',
          'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'referrerStoreId', 'referrerStoreName', 'referrerOwnerUid', 'referrerCode',
          'referredStoreId', 'referredStoreName', 'referredOwnerUid',
          'status', 'rewardCouponId', 'rewardCouponCode', 'createdAt', 'updatedAt'
        ]) &&
        data.id == referralId &&
        isValidId(data.id) &&
        isValidId(data.referrerStoreId) &&
        data.referrerStoreName is string && data.referrerStoreName.size() >= 2 && data.referrerStoreName.size() <= 100 &&
        isValidId(data.referrerOwnerUid) &&
        isValidReferralCode(data.referrerCode) &&
        isValidId(data.referredStoreId) &&
        data.referredStoreName is string && data.referredStoreName.size() >= 2 && data.referredStoreName.size() <= 100 &&
        isValidId(data.referredOwnerUid) &&
        data.referrerOwnerUid != data.referredOwnerUid &&
        data.referrerStoreId != data.referredStoreId &&
        data.status in ['registered', 'rewarded'] &&
        (!('rewardCouponId' in data) || isValidId(data.rewardCouponId)) &&
        (!('rewardCouponCode' in data) || isValidReferralCode(data.rewardCouponCode)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReferralCoupon(data, couponId) {
      return data.keys().hasAll([
          'id', 'code', 'storeId', 'storeName', 'ownerUid',
          'discountUSD', 'status', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'code', 'storeId', 'storeName', 'ownerUid',
          'discountUSD', 'sourceReferralId', 'referredStoreName',
          'status', 'appliedPaymentId', 'createdAt', 'updatedAt'
        ]) &&
        data.id == couponId &&
        isValidId(data.id) &&
        isValidReferralCode(data.code) &&
        isValidId(data.storeId) &&
        data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 100 &&
        isValidId(data.ownerUid) &&
        data.discountUSD is number && data.discountUSD > 0 && data.discountUSD <= 1000 &&
        (!('sourceReferralId' in data) || isValidId(data.sourceReferralId)) &&
        (!('referredStoreName' in data) || (data.referredStoreName is string && data.referredStoreName.size() <= 100)) &&
        (!('appliedPaymentId' in data) || isValidId(data.appliedPaymentId)) &&
        data.status in ['available', 'applied', 'redeemed'] &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidAdminEmailDispatch(data, emailId) {
      return data.keys().hasAll([
          'id', 'mode', 'subject', 'body', 'recipientCount',
          'recipientEmailsSummary', 'sentByEmail', 'deliveryChannel', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'mode', 'subject', 'body', 'recipientCount',
          'recipientEmailsSummary', 'targetStoreNames', 'sentByEmail',
          'deliveryChannel', 'createdAt'
        ]) &&
        data.id == emailId &&
        isValidId(data.id) &&
        data.mode in ['individual', 'collective'] &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 180 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 5000 &&
        data.recipientCount is number && data.recipientCount >= 1 && data.recipientCount <= 5000 &&
        data.recipientEmailsSummary is string && data.recipientEmailsSummary.size() <= 2000 &&
        (!('targetStoreNames' in data) || (data.targetStoreNames is string && data.targetStoreNames.size() <= 1000)) &&
        data.sentByEmail is string && data.sentByEmail.size() >= 5 && data.sentByEmail.size() <= 160 &&
        data.deliveryChannel in ['smtp', 'resend', 'cloud_inbox_mailto'] &&
        data.createdAt is timestamp;
    }

    function isValidStoreInboxMessage(data, storeId, messageId) {
      return data.keys().hasAll([
          'id', 'storeId', 'storeOwnerUid', 'subject', 'body',
          'senderEmail', 'category', 'isRead', 'createdAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'storeOwnerUid', 'subject', 'body',
          'senderEmail', 'category', 'isRead', 'createdAt'
        ]) &&
        data.id == messageId &&
        isValidId(data.id) &&
        data.storeId == storeId &&
        isValidId(data.storeId) &&
        isValidId(data.storeOwnerUid) &&
        data.subject is string && data.subject.size() >= 1 && data.subject.size() <= 180 &&
        data.body is string && data.body.size() >= 1 && data.body.size() <= 5000 &&
        data.senderEmail is string && data.senderEmail.size() >= 5 && data.senderEmail.size() <= 160 &&
        data.category in ['admin_email', 'referral_reward', 'system'] &&
        data.isRead is bool &&
        data.createdAt is timestamp;
    }

    function isValidVectorBrandConfig(data, storeId) {
      return data.keys().hasAll([
          'storeId', 'brandName', 'idiomaPrincipal', 'tratamientoEs', 'emojiMax', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'storeId', 'brandName', 'idiomaPrincipal', 'tratamientoEs', 'tratamientoZh', 'emojiMax',
          'politicaEnvios', 'politicaDevoluciones', 'slaHumano', 'horarioAtencion', 'zonaHoraria',
          'slaCriticaMin', 'slaAltaMin', 'slaMediaMin', 'nivel1Cola', 'nivel2Cobros',
          'nivel2Logistica', 'nivel3Supervisor', 'nivel4Admin', 'autoEscalarPorVencimiento',
          'maxIntentosBot', 'canalOfertas', 'frecuenciaMaximaSemanal', 'palancasSummary', 'updatedAt'
        ]) &&
        data.storeId == storeId &&
        isValidId(data.storeId) &&
        data.brandName is string && data.brandName.size() >= 2 && data.brandName.size() <= 100 &&
        data.idiomaPrincipal in ['es', 'en', 'zh'] &&
        data.tratamientoEs in ['usted', 'tu'] &&
        (!('tratamientoZh' in data) || data.tratamientoZh in ['您', '你']) &&
        data.emojiMax in [0, 1] &&
        (!('politicaEnvios' in data) || (data.politicaEnvios is string && data.politicaEnvios.size() <= 600)) &&
        (!('politicaDevoluciones' in data) || (data.politicaDevoluciones is string && data.politicaDevoluciones.size() <= 600)) &&
        (!('slaHumano' in data) || (data.slaHumano is string && data.slaHumano.size() <= 80)) &&
        (!('horarioAtencion' in data) || (data.horarioAtencion is string && data.horarioAtencion.size() <= 100)) &&
        (!('zonaHoraria' in data) || (data.zonaHoraria is string && data.zonaHoraria.size() <= 40)) &&
        (!('slaCriticaMin' in data) || (data.slaCriticaMin is number && data.slaCriticaMin >= 1 && data.slaCriticaMin <= 1440)) &&
        (!('slaAltaMin' in data) || (data.slaAltaMin is number && data.slaAltaMin >= 1 && data.slaAltaMin <= 2880)) &&
        (!('slaMediaMin' in data) || (data.slaMediaMin is number && data.slaMediaMin >= 1 && data.slaMediaMin <= 10080)) &&
        (!('nivel1Cola' in data) || (data.nivel1Cola is string && data.nivel1Cola.size() <= 100)) &&
        (!('nivel2Cobros' in data) || (data.nivel2Cobros is string && data.nivel2Cobros.size() <= 100)) &&
        (!('nivel2Logistica' in data) || (data.nivel2Logistica is string && data.nivel2Logistica.size() <= 100)) &&
        (!('nivel3Supervisor' in data) || (data.nivel3Supervisor is string && data.nivel3Supervisor.size() <= 100)) &&
        (!('nivel4Admin' in data) || (data.nivel4Admin is string && data.nivel4Admin.size() <= 100)) &&
        (!('autoEscalarPorVencimiento' in data) || data.autoEscalarPorVencimiento is bool) &&
        (!('maxIntentosBot' in data) || (data.maxIntentosBot is number && data.maxIntentosBot >= 1 && data.maxIntentosBot <= 5)) &&
        (!('canalOfertas' in data) || data.canalOfertas in ['email', 'whatsapp', 'ambos']) &&
        (!('frecuenciaMaximaSemanal' in data) || (data.frecuenciaMaximaSemanal is number && data.frecuenciaMaximaSemanal >= 0 && data.frecuenciaMaximaSemanal <= 14)) &&
        (!('palancasSummary' in data) || (data.palancasSummary is string && data.palancasSummary.size() <= 240)) &&
        data.updatedAt is timestamp;
    }

    function isValidVectorTicket(data, ticketId) {
      return data.keys().hasAll([
          'id', 'ticketNumber', 'storeId', 'storeName', 'storeOwnerUid', 'requesterUid',
          'level', 'priority', 'slaMinutes', 'summary', 'status', 'handoffPacket',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'ticketNumber', 'storeId', 'storeName', 'storeOwnerUid', 'requesterUid',
          'customerName', 'customerContact', 'channel', 'language', 'triggerId', 'triggerMotivo',
          'level', 'priority', 'slaMinutes', 'summary', 'botAttempts', 'lastProposal', 'orderRef',
          'evidence', 'requiredHumanAction', 'clientCommitment', 'offerConsent', 'risk', 'threadId',
          'status', 'handoffPacket', 'adminReport', 'reEscalatedCount', 'contextLeakReported',
          'csatScore', 'dueAtMs', 'createdAt', 'updatedAt'
        ]) &&
        data.id == ticketId &&
        isValidId(data.id) &&
        data.ticketNumber is string && data.ticketNumber.size() >= 3 && data.ticketNumber.size() <= 40 &&
        isValidId(data.storeId) &&
        data.storeName is string && data.storeName.size() >= 2 && data.storeName.size() <= 100 &&
        isValidId(data.storeOwnerUid) &&
        isValidId(data.requesterUid) &&
        (!('customerName' in data) || (data.customerName is string && data.customerName.size() <= 100)) &&
        (!('customerContact' in data) || (data.customerContact is string && data.customerContact.size() <= 160)) &&
        (!('channel' in data) || data.channel in ['web_chat', 'whatsapp', 'instagram', 'email']) &&
        (!('language' in data) || data.language in ['es', 'en', 'zh']) &&
        (!('triggerId' in data) || (data.triggerId is number && data.triggerId >= 0 && data.triggerId <= 99)) &&
        (!('triggerMotivo' in data) || (data.triggerMotivo is string && data.triggerMotivo.size() <= 120)) &&
        data.level in ['N0', 'N1', 'N2', 'N3', 'N4'] &&
        data.priority in ['media', 'alta', 'critica'] &&
        data.slaMinutes is number && data.slaMinutes >= 1 && data.slaMinutes <= 10080 &&
        data.summary is string && data.summary.size() >= 3 && data.summary.size() <= 600 &&
        (!('botAttempts' in data) || (data.botAttempts is number && data.botAttempts >= 0 && data.botAttempts <= 10)) &&
        (!('lastProposal' in data) || (data.lastProposal is string && data.lastProposal.size() <= 400)) &&
        (!('orderRef' in data) || (data.orderRef is string && data.orderRef.size() <= 80)) &&
        (!('evidence' in data) || (data.evidence is string && data.evidence.size() <= 400)) &&
        (!('requiredHumanAction' in data) || (data.requiredHumanAction is string && data.requiredHumanAction.size() <= 300)) &&
        (!('clientCommitment' in data) || (data.clientCommitment is string && data.clientCommitment.size() <= 300)) &&
        (!('offerConsent' in data) || data.offerConsent in ['si', 'no', 'solo_importante', 'no_preguntado']) &&
        (!('risk' in data) || data.risk in ['ninguno', 'reembolso', 'legal', 'fraude', 'reputacional']) &&
        (!('threadId' in data) || (data.threadId is string && data.threadId.size() <= 120)) &&
        data.status in ['open', 'in_progress', 'escalated', 'resolved'] &&
        data.handoffPacket is string && data.handoffPacket.size() >= 10 && data.handoffPacket.size() <= 2000 &&
        (!('adminReport' in data) || (data.adminReport is string && data.adminReport.size() <= 1500)) &&
        (!('reEscalatedCount' in data) || (data.reEscalatedCount is number && data.reEscalatedCount >= 0 && data.reEscalatedCount <= 20)) &&
        (!('contextLeakReported' in data) || data.contextLeakReported is bool) &&
        (!('csatScore' in data) || (data.csatScore is number && data.csatScore >= 1 && data.csatScore <= 5)) &&
        (!('dueAtMs' in data) || (data.dueAtMs is number && data.dueAtMs >= 0)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVectorConsent(data, consentId) {
      return data.keys().hasAll([
          'id', 'userUid', 'storeId', 'storeOwnerUid', 'scope', 'status', 'channel', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'userUid', 'userEmail', 'storeId', 'storeName', 'storeOwnerUid',
          'scope', 'status', 'channel', 'hardBounced', 'recentComplaint', 'updatedAt'
        ]) &&
        data.id == consentId &&
        isValidId(data.id) &&
        isValidId(data.userUid) &&
        (!('userEmail' in data) || (data.userEmail is string && data.userEmail.size() <= 160)) &&
        isValidId(data.storeId) &&
        (!('storeName' in data) || (data.storeName is string && data.storeName.size() <= 100)) &&
        isValidId(data.storeOwnerUid) &&
        data.scope in ['buyer_offers', 'merchant_campaigns'] &&
        data.status in ['si', 'no', 'solo_importante'] &&
        data.channel in ['web_chat', 'whatsapp', 'email', 'portal'] &&
        (!('hardBounced' in data) || data.hardBounced is bool) &&
        (!('recentComplaint' in data) || data.recentComplaint is bool) &&
        data.updatedAt is timestamp;
    }

    function isValidVectorCampaign(data, campaignId) {
      return data.keys().hasAll([
          'id', 'title', 'segment', 'objective', 'realOffer', 'validUntil',
          'primaryLanguage', 'approvedByAdmin', 'status', 'createdByEmail', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'title', 'segment', 'objective', 'realOffer', 'validUntil',
          'primaryLanguage', 'variantsJson', 'approvedByAdmin', 'approvedAtIso', 'status',
          'sentCount', 'excludedCount', 'openCount', 'clickCount', 'attributedSalesCount',
          'optOutCount', 'bounceCount', 'createdByEmail', 'createdAt', 'updatedAt'
        ]) &&
        data.id == campaignId &&
        isValidId(data.id) &&
        data.title is string && data.title.size() >= 2 && data.title.size() <= 140 &&
        data.segment in ['all', 'active', 'pending', 'low_activity'] &&
        data.objective is string && data.objective.size() <= 300 &&
        data.realOffer is string && data.realOffer.size() <= 300 &&
        data.validUntil is string && data.validUntil.size() >= 4 && data.validUntil.size() <= 40 &&
        data.primaryLanguage in ['es', 'en', 'zh'] &&
        (!('variantsJson' in data) || (data.variantsJson is string && data.variantsJson.size() <= 12000)) &&
        data.approvedByAdmin is bool &&
        (!('approvedAtIso' in data) || (data.approvedAtIso is string && data.approvedAtIso.size() <= 40)) &&
        data.status in ['draft', 'approved', 'sent'] &&
        (!('sentCount' in data) || (data.sentCount is number && data.sentCount >= 0 && data.sentCount <= 50000)) &&
        (!('excludedCount' in data) || (data.excludedCount is number && data.excludedCount >= 0 && data.excludedCount <= 50000)) &&
        (!('openCount' in data) || (data.openCount is number && data.openCount >= 0 && data.openCount <= 50000)) &&
        (!('clickCount' in data) || (data.clickCount is number && data.clickCount >= 0 && data.clickCount <= 50000)) &&
        (!('attributedSalesCount' in data) || (data.attributedSalesCount is number && data.attributedSalesCount >= 0 && data.attributedSalesCount <= 50000)) &&
        (!('optOutCount' in data) || (data.optOutCount is number && data.optOutCount >= 0 && data.optOutCount <= 50000)) &&
        (!('bounceCount' in data) || (data.bounceCount is number && data.bounceCount >= 0 && data.bounceCount <= 50000)) &&
        data.createdByEmail is string && data.createdByEmail.size() >= 5 && data.createdByEmail.size() <= 160 &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidVectorConversationStat(data, statId) {
      return data.keys().hasAll([
          'id', 'storeId', 'storeOwnerUid', 'userUid', 'language',
          'turnsCount', 'containedByBot', 'escalated', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'storeOwnerUid', 'userUid', 'language',
          'turnsCount', 'botAttemptsOnIssue', 'containedByBot', 'escalated',
          'escalationAccurate', 'triggerId', 'createdAt', 'updatedAt'
        ]) &&
        data.id == statId &&
        isValidId(data.id) &&
        isValidId(data.storeId) &&
        isValidId(data.storeOwnerUid) &&
        isValidId(data.userUid) &&
        data.language in ['es', 'en', 'zh'] &&
        data.turnsCount is number && data.turnsCount >= 0 && data.turnsCount <= 1000 &&
        (!('botAttemptsOnIssue' in data) || (data.botAttemptsOnIssue is number && data.botAttemptsOnIssue >= 0 && data.botAttemptsOnIssue <= 50)) &&
        data.containedByBot is bool &&
        data.escalated is bool &&
        (!('escalationAccurate' in data) || data.escalationAccurate is bool) &&
        (!('triggerId' in data) || (data.triggerId is number && data.triggerId >= 0 && data.triggerId <= 99)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidUserLanguagePreference(data, uid) {
      return data.keys().hasAll(['uid', 'language', 'updatedAt']) &&
        data.keys().hasOnly(['uid', 'language', 'updatedAt']) &&
        data.uid == uid &&
        isValidId(data.uid) &&
        data.language in ['es', 'en', 'zh'] &&
        data.updatedAt is timestamp;
    }

    function isValidWarehouseProduct(data, storeId, productId) {
      return data.keys().hasAll([
          'id', 'storeId', 'ownerUid', 'name', 'category', 'sku',
          'stock', 'minStock', 'costUSD', 'priceUSD', 'unit', 'barcode',
          'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'id', 'storeId', 'ownerUid', 'name', 'category', 'sku',
          'stock', 'minStock', 'costUSD', 'priceUSD', 'unit', 'barcode',
          'image', 'description', 'rating', 'turnoverRate', 'batchNumber',
          'supplier', 'location', 'expirationDate', 'storefrontProductId',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == productId &&
        isValidId(data.id) &&
        data.storeId == storeId &&
        isValidId(data.storeId) &&
        isValidId(data.ownerUid) &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 140 &&
        data.category is string && data.category.size() <= 60 &&
        data.sku is string && data.sku.size() <= 60 &&
        data.stock is number && data.stock >= 0 && data.stock <= 1000000 &&
        data.minStock is number && data.minStock >= 0 && data.minStock <= 1000000 &&
        data.costUSD is number && data.costUSD >= 0 && data.costUSD <= 1000000 &&
        data.priceUSD is number && data.priceUSD >= 0 && data.priceUSD <= 1000000 &&
        data.unit is string && data.unit.size() >= 1 && data.unit.size() <= 30 &&
        data.barcode is string && data.barcode.size() <= 80 &&
        (!('image' in data) || (data.image is string && data.image.size() <= 150000)) &&
        (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
        (!('rating' in data) || (data.rating is number && data.rating >= 1 && data.rating <= 5)) &&
        (!('turnoverRate' in data) || data.turnoverRate in ['Alta', 'Media', 'Baja']) &&
        (!('batchNumber' in data) || (data.batchNumber is string && data.batchNumber.size() <= 60)) &&
        (!('supplier' in data) || (data.supplier is string && data.supplier.size() <= 120)) &&
        (!('location' in data) || (data.location is string && data.location.size() <= 60)) &&
        (!('expirationDate' in data) || (data.expirationDate is string && data.expirationDate.size() <= 30)) &&
        (!('storefrontProductId' in data) || isValidId(data.storefrontProductId)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidWarehouseLedger(data, storeId, ledgerId) {
      return ledgerId in ['debtors', 'movements', 'sales', 'audits', 'traces', 'purchases', 'closings'] &&
        data.keys().hasAll(['id', 'storeId', 'ownerUid', 'entriesJson', 'updatedAt']) &&
        data.keys().hasOnly(['id', 'storeId', 'ownerUid', 'entriesJson', 'updatedAt']) &&
        data.id == ledgerId &&
        data.storeId == storeId &&
        isValidId(data.storeId) &&
        isValidId(data.ownerUid) &&
        data.entriesJson is string && data.entriesJson.size() <= 750000 &&
        data.updatedAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Match Rules
    // -------------------------------------------------------------------------

    match /admins/{uid} {
      allow get: if isValidId(uid) && isVerifiedUser() && (request.auth.uid == uid || isAdmin());
      allow list: if isSuperAdminEmail();
      allow create: if isValidId(uid) && isSuperAdminEmail() &&
        isValidAdminUser(incoming(), uid) &&
        incoming().createdAt == request.time;
      allow update: if isValidId(uid) && isSuperAdminEmail() &&
        isValidAdminUser(incoming(), uid) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt;
      allow delete: if false;
    }

    match /platformSettings/{settingId} {
      allow get: if settingId == 'billing';
      allow list: if isSuperAdminEmail();
      allow create: if settingId == 'billing' && isAdmin() &&
        isValidPlatformBilling(incoming()) &&
        incoming().updatedAt == request.time;
      allow update: if settingId == 'billing' && isAdmin() &&
        isValidPlatformBilling(incoming()) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /platform_billing/{methodId} {
      allow get: if isValidId(methodId) && (isAdmin() || (resource != null && resource.data.isActive == true));
      allow list: if resource.data.isActive == true || isSuperAdminEmail();
      allow create: if isValidId(methodId) && isAdmin() &&
        isValidPlatformPaymentMethod(incoming(), methodId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(methodId) && isAdmin() &&
        isValidPlatformPaymentMethod(incoming(), methodId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(methodId) && isAdmin();
    }

    match /platformPaymentMethods/{methodId} {
      allow get: if isValidId(methodId) && (isAdmin() || (resource != null && resource.data.isActive == true));
      allow list: if resource.data.isActive == true || isSuperAdminEmail();
      allow create: if isValidId(methodId) && isAdmin() &&
        isValidPlatformPaymentMethod(incoming(), methodId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(methodId) && isAdmin() &&
        isValidPlatformPaymentMethod(incoming(), methodId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(methodId) && isAdmin();
    }

    match /salesPaymentMethods/{methodId} {
      allow get: if isValidId(methodId) && ((resource != null && existing().isActive == true) || isAdmin());
      allow list: if resource.data.isActive == true || isSuperAdminEmail();
      allow create: if isValidId(methodId) && isAdmin() &&
        isValidSalesPaymentMethod(incoming(), methodId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(methodId) && isAdmin() &&
        isValidSalesPaymentMethod(incoming(), methodId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidId(methodId) && isAdmin();
    }

    match /storeOwnerClaims/{claimId} {
      allow get: if isValidId(claimId) && isVerifiedUser() && (
        isAdmin() ||
        (resource != null && (
          existing().ownerEmail == request.auth.token.email ||
          ('claimedByUid' in existing() && existing().claimedByUid == request.auth.uid)
        ))
      );
      allow list: if isVerifiedUser() && (
        isSuperAdminEmail() ||
        resource.data.ownerEmail == request.auth.token.email ||
        ('claimedByUid' in resource.data && resource.data.claimedByUid == request.auth.uid)
      );
      allow create: if isValidId(claimId) && isAdmin() &&
        isValidStoreOwnerClaim(incoming(), claimId) &&
        incoming().status == 'pending_claim' &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidId(claimId) && isVerifiedUser() &&
        isValidStoreOwnerClaim(incoming(), claimId) &&
        incoming().id == existing().id &&
        incoming().storeId == existing().storeId &&
        incoming().pendingOwnerUid == existing().pendingOwnerUid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            existing().status == 'pending_claim' &&
            existing().ownerEmail == request.auth.token.email &&
            incoming().status == 'claimed' &&
            'claimedByUid' in incoming() &&
            incoming().claimedByUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly(['status', 'claimedByUid', 'updatedAt'])
          )
        );
      allow delete: if isValidId(claimId) && isAdmin();
    }

    match /stores/{storeId} {
      allow get: if isValidId(storeId) && (
        isAdmin() ||
        (resource != null && (
          existing().status == 'active' ||
          (isVerifiedUser() && existing().ownerUid == request.auth.uid)
        ))
      );
      allow list: if resource.data.status == 'active' ||
        isSuperAdminEmail() ||
        (isVerifiedUser() && resource.data.ownerUid == request.auth.uid);

      allow create: if isValidId(storeId) && isVerifiedUser() &&
        isValidStoreTenant(incoming(), storeId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            incoming().ownerUid == request.auth.uid &&
            incoming().status == 'pending' &&
            (!('warehousePosEnabled' in incoming()) || incoming().warehousePosEnabled == false) &&
            (!('referralRewardGranted' in incoming()) || incoming().referralRewardGranted == false) &&
            (!('referredByStoreId' in incoming()) || incoming().referredByStoreId != storeId) &&
            (!('referredByCode' in incoming()) || (
              exists(/databases/$(database)/documents/referralCodes/$(incoming().referredByCode)) &&
              get(/databases/$(database)/documents/referralCodes/$(incoming().referredByCode)).data.ownerUid != request.auth.uid &&
              'referredByStoreId' in incoming() &&
              incoming().referredByStoreId == get(/databases/$(database)/documents/referralCodes/$(incoming().referredByCode)).data.storeId
            ))
          )
        );

      allow update: if isValidId(storeId) && isVerifiedUser() &&
        isValidStoreTenant(incoming(), storeId) &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          isAdmin() ||
          (
            incoming().ownerUid == existing().ownerUid &&
            existing().ownerUid == request.auth.uid &&
            incoming().status == existing().status &&
            incoming().subscriptionPriceUSD == existing().subscriptionPriceUSD &&
            ((!('warehousePosEnabled' in incoming()) && !('warehousePosEnabled' in existing())) ||
             (('warehousePosEnabled' in incoming()) && ('warehousePosEnabled' in existing()) && incoming().warehousePosEnabled == existing().warehousePosEnabled)) &&
            (!('referralCode' in existing()) || ('referralCode' in incoming() && incoming().referralCode == existing().referralCode)) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'storeName', 'slug', 'registeredOwnerName', 'rif', 'logoUrl',
              'businessWhatsapp', 'category', 'description',
              'nationalShippingEnabled', 'nationalCouriers',
              'localDeliveryEnabled', 'localDeliveryFeeUSD', 'localDeliveryZone',
              'pickupEnabled', 'referralCode', 'updatedAt'
            ])
          ) ||
          (
