        allow update: if isValidId(storeId) && docId in ['account', 'emailConfig'] && isVerifiedUser() &&
          incoming().storeId == existing().storeId &&
          incoming().updatedAt == request.time &&
          (
            (docId == 'account' &&
             isValidStorePrivateAccount(incoming(), storeId) &&
