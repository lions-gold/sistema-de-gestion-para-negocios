                get(/databases/$(database)/documents/storeOwnerClaims/$(storeId)).data.pendingOwnerUid == existing().ownerUid &&
                get(/databases/$(database)/documents/storeOwnerClaims/$(storeId)).data.ownerEmail == request.auth.token.email &&
                getAfter(/databases/$(database)/documents/storeOwnerClaims/$(storeId)).data.status == 'claimed' &&
                getAfter(/databases/$(database)/documents/storeOwnerClaims/$(storeId)).data.claimedByUid == request.auth.uid)
             )) ||
            (docId == 'emailConfig' &&
             isValidStoreEmailConfig(incoming(), storeId) &&
             incoming().ownerUid == existing().ownerUid &&
             (
               isAdmin() ||
               (existing().ownerUid == request.auth.uid &&
                incoming().diff(existing()).affectedKeys().hasOnly([
                  'provider', 'isEnabled', 'recipientEmail', 'secondaryEmail',
                  'fromName', 'fromEmail', 'resendApiKey',
                  'smtpHost', 'smtpPort', 'smtpSecure', 'smtpUser', 'smtpPass',
                  'alertOnCriticalStock', 'notifyOnPOS', 'notifyOnManualAdjustment', 'alertFrequency',
                  'sendSalesReports', 'salesReportFrequency',
                  'lastTestStatus', 'lastTestAt', 'updatedAt'
                ]))
             ))
          );
        allow delete: if isValidId(storeId) && (
          isAdmin() ||
          (docId == 'emailConfig' && isVerifiedUser() && resource != null && existing().ownerUid == request.auth.uid)
        );
