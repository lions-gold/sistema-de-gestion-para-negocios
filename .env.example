# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Google Analytics 4 & Search Console (Optional overrides)
VITE_GA_MEASUREMENT_ID="G-SM1TH2026EC"
VITE_GSC_VERIFICATION="SmithSolutionsECommerce-GSC-2026-Verified"

# Optional Email Delivery (Admin Panel -> Store Owners)
# Configure SMTP (e.g. Gmail App Password, Zoho, Brevo) OR Resend API Key
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="empresaalhadiqainvest@gmail.com"
RESEND_API_KEY=""

# Optional Vercel/Same-Origin Auth proxy for mobile Safari ITP compatibility
# Set to "true" ONLY after adding https://<your-domain>/__/auth/handler to Google Cloud OAuth Redirect URIs
VITE_USE_SAME_ORIGIN_AUTH="false"

# Optional Self-Hosted Supabase Auth Backup (Client Public Vars - safe for GitHub Pages / Vercel)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# Server-Only Self-Hosted Supabase Sync (Vercel / Express backend ONLY - NEVER prefix with VITE_)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Open-Source Server OAuth (/api/auth/google, /api/auth/callback/google, HTTP-only session cookie)
# Configure in Vercel Environment Variables; add https://sistema-de-gestion-para-negocios.vercel.app/api/auth/callback/google in Google Cloud
AUTH_SECRET=""
AUTH_URL=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Optional Firebase Client Overrides (falls back to firebase-applet-config.json if empty)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""
