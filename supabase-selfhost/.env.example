# Self-Hosted Supabase Environment Template
# Copy this file to .env ONLY on your deployment server (Coolify / Railway / VPS).
# NEVER commit .env with real keys to GitHub.

# --- Core Secrets (generate strong random values >= 32 chars) ---
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD_MIN_32_CHARS
JWT_SECRET=CHANGE_ME_SUPER_SECRET_JWT_KEY_AT_LEAST_32_CHARACTERS

# Generate ANON_KEY and SERVICE_ROLE_KEY signed with JWT_SECRET:
# payload anon:         {"role":"anon","iss":"supabase","iat":1735689600,"exp":1999999999}
# payload service_role: {"role":"service_role","iss":"supabase","iat":1735689600,"exp":1999999999}
ANON_KEY=REPLACE_WITH_SIGNED_ANON_JWT
SERVICE_ROLE_KEY=REPLACE_WITH_SIGNED_SERVICE_ROLE_JWT

# --- Public URLs & Redirect Allowlist ---
# Example: https://auth-backup.tu-dominio.com
SUPABASE_PUBLIC_URL=https://supabase.tu-dominio.com
SITE_URL=https://sistema-de-gestion-para-negocios.vercel.app
ADDITIONAL_REDIRECT_URLS=https://sistema-de-gestion-para-negocios.vercel.app/**,https://*.github.io/**,http://localhost:3000/**
KONG_HTTP_PORT=8000
JWT_EXPIRY=3600

# --- Google OAuth 2.0 (for Mobile/Web PKCE failover) ---
# Add https://supabase.tu-dominio.com/auth/v1/callback to Google Cloud Console Authorized Redirect URIs
ENABLE_GOOGLE_AUTH=true
GOOGLE_OAUTH_CLIENT_ID=8053852491-3tic0969dn4oipr3bku5mves68irpesn.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=REPLACE_WITH_GOOGLE_OAUTH_CLIENT_SECRET

# --- Transactional Email / SMTP (GoTrue Confirmation & Password Recovery) ---
# Compatible with Resend SMTP (smtp.resend.com:587, user=resend, pass=re_xxx),
# Brevo, Postmark, or Gmail App Password (smtp.gmail.com:587 or 465).
ENABLE_EMAIL_AUTOCONFIRM=false
MAILER_OTP_EXP=3600
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD_OR_RESEND_API_KEY
SMTP_ADMIN_EMAIL=no-reply@tu-dominio.com
SMTP_SENDER_NAME=Smith Solutions
SMTP_MAX_FREQUENCY=1m0s
RATE_LIMIT_EMAIL_SENT=30
