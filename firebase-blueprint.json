        "provider": { "type": "string", "enum": ["resend", "smtp"] },
        "isEnabled": { "type": "boolean" },
        "recipientEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "secondaryEmail": { "type": "string", "maxLength": 160 },
