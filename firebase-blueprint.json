{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized Super Admin identity document for platform governance.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "role": { "type": "string", "enum": ["superadmin"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "createdAt"]
    },
    "PlatformBillingSettings": {
      "title": "PlatformBillingSettings",
      "description": "Global $25/month SaaS subscription payment instructions and referral coupon reward configured by Super Admin.",
      "type": "object",
      "properties": {
        "monthlyPriceUSD": { "type": "number" },
        "bankTransfers": { "type": "string", "maxLength": 1000 },
        "pagoMovil": { "type": "string", "maxLength": 500 },
        "binancePay": { "type": "string", "maxLength": 300 },
        "bybitPay": { "type": "string", "maxLength": 300 },
        "binanceQrUrl": { "type": "string", "maxLength": 150000 },
        "bybitQrUrl": { "type": "string", "maxLength": 150000 },
        "supportWhatsapp": { "type": "string", "maxLength": 40 },
        "warehousePosEnabled": { "type": "boolean" },
        "referralRewardUSD": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "monthlyPriceUSD",
        "bankTransfers",
        "pagoMovil",
        "binancePay",
        "bybitPay",
        "supportWhatsapp",
        "updatedAt"
      ]
    },
    "PlatformPaymentMethod": {
      "title": "PlatformPaymentMethod",
      "description": "Custom subscription collection payment method manually configured by Super Admin (e.g., Zelle, Zinli, Wally, Banesco Panama).",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "currency": { "type": "string", "enum": ["USD", "Bs", "USDT", "EUR", "Otro"] },
        "accountHolder": { "type": "string", "maxLength": 120 },
        "accountDetails": { "type": "string", "minLength": 2, "maxLength": 300 },
        "instructions": { "type": "string", "maxLength": 400 },
        "qrImageUrl": { "type": "string", "maxLength": 150000 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "currency", "accountHolder", "accountDetails", "isActive", "createdAt", "updatedAt"]
    },
    "SalesPaymentMethod": {
      "title": "SalesPaymentMethod",
      "description": "Admin-managed customizable payment method catalog (e.g., Binance Pay, Zinli, Transferencia Banesco, Zelle) selectable by store owners when registering sales.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "currency": { "type": "string", "enum": ["USD", "Bs", "USDT", "EUR", "Otro"] },
        "appliesIgtf": { "type": "boolean" },
        "description": { "type": "string", "maxLength": 240 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "currency", "appliesIgtf", "isActive", "createdAt", "updatedAt"]
    },
    "StorePaymentMethod": {
      "title": "StorePaymentMethod",
      "description": "Custom payment and money collection method manually configured by each Store Owner for buyer checkout and sales registration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "currency": { "type": "string", "enum": ["USD", "Bs", "USDT", "EUR", "Otro"] },
        "accountHolder": { "type": "string", "maxLength": 120 },
        "accountDetails": { "type": "string", "minLength": 2, "maxLength": 300 },
        "instructions": { "type": "string", "maxLength": 400 },
        "qrImageUrl": { "type": "string", "maxLength": 150000 },
        "appliesIgtf": { "type": "boolean" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "storeId", "ownerUid", "name", "currency", "accountHolder", "accountDetails", "appliesIgtf", "isActive", "createdAt", "updatedAt"]
    },
    "StoreSubscriptionPaymentMethod": {
      "title": "StoreSubscriptionPaymentMethod",
      "description": "Custom subscription collection payment method manually configured by Super Admin for a specific registered store.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 80 },
        "currency": { "type": "string", "enum": ["USD", "Bs", "USDT", "EUR", "Otro"] },
        "accountHolder": { "type": "string", "maxLength": 120 },
        "accountDetails": { "type": "string", "minLength": 2, "maxLength": 300 },
        "instructions": { "type": "string", "maxLength": 400 },
        "qrImageUrl": { "type": "string", "maxLength": 150000 },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "storeId",
        "storeName",
        "ownerUid",
        "name",
        "currency",
        "accountHolder",
        "accountDetails",
        "isActive",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoreOwnerClaim": {
      "title": "StoreOwnerClaim",
      "description": "Pre-registered store owner assignment created manually by Super Admin so the designated email automatically claims ownership upon verified Google login.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "ownerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "ownerEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "pendingOwnerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "claimedByUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "status": { "type": "string", "enum": ["pending_claim", "claimed"] },
        "createdByEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "storeId",
        "storeName",
        "ownerName",
        "ownerEmail",
        "pendingOwnerUid",
        "status",
        "createdByEmail",
        "createdAt",
        "updatedAt"
      ]
    },
    "StoreTenant": {
      "title": "StoreTenant",
      "description": "Multi-SaaS merchant storefront account with business profile, RIF, logo, shipping config, referral code, and activation status.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "slug": { "type": "string", "maxLength": 80, "pattern": "^[a-z0-9\\-]+$" },
        "ownerUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "storeName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "registeredOwnerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "rif": { "type": "string", "maxLength": 30 },
        "logoUrl": { "type": "string", "maxLength": 150000 },
        "businessWhatsapp": { "type": "string", "minLength": 7, "maxLength": 25 },
        "category": { "type": "string", "maxLength": 60 },
        "description": { "type": "string", "maxLength": 500 },
        "socialLinks": {
          "type": "object",
          "properties": {
            "instagram": { "type": "string", "maxLength": 200 },
            "tiktok": { "type": "string", "maxLength": 200 },
            "facebook": { "type": "string", "maxLength": 200 },
            "x": { "type": "string", "maxLength": 200 },
            "youtube": { "type": "string", "maxLength": 200 },
            "telegram": { "type": "string", "maxLength": 200 },
            "website": { "type": "string", "maxLength": 200 }
          }
        },
        "status": { "type": "string", "enum": ["pending", "active", "suspended"] },
        "subscriptionPriceUSD": { "type": "number" },
        "nationalShippingEnabled": { "type": "boolean" },
        "nationalCouriers": { "type": "string", "maxLength": 200 },
        "localDeliveryEnabled": { "type": "boolean" },
        "localDeliveryFeeUSD": { "type": "number" },
        "localDeliveryZone": { "type": "string", "maxLength": 150 },
        "pickupEnabled": { "type": "boolean" },
        "warehousePosEnabled": { "type": "boolean" },
        "clothingSizesEnabled": { "type": "boolean" },
        "defaultClothingSizes": { "type": "array", "maxItems": 40, "items": { "type": "string", "maxLength": 24 } },
        "referralCode": { "type": "string", "maxLength": 32, "pattern": "^[A-Z0-9\\-]+$" },
        "referredByCode": { "type": "string", "maxLength": 32, "pattern": "^[A-Z0-9\\-]+$" },
        "referredByStoreId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "referredByStoreName": { "type": "string", "maxLength": 100 },
        "referralRewardGranted": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "slug",
        "ownerUid",
        "storeName",
        "registeredOwnerName",
        "businessWhatsapp",
        "status",
        "subscriptionPriceUSD",
        "nationalShippingEnabled",
        "localDeliveryEnabled",
        "pickupEnabled",
        "createdAt",
        "updatedAt"
      ]
    },
    "StorePrivateAccount": {
      "title": "StorePrivateAccount",
