        "fromEmail": { "type": "string", "maxLength": 160 },
        "resendApiKey": { "type": "string", "maxLength": 300 },
        "smtpHost": { "type": "string", "maxLength": 160 },
        "smtpPort": { "type": "number" },
        "smtpSecure": { "type": "boolean" },
        "smtpUser": { "type": "string", "maxLength": 160 },
        "smtpPass": { "type": "string", "maxLength": 300 },
        "alertOnCriticalStock": { "type": "boolean" },
        "notifyOnPOS": { "type": "boolean" },
        "notifyOnManualAdjustment": { "type": "boolean" },
        "alertFrequency": { "type": "string", "enum": ["immediate", "daily"] },
        "sendSalesReports": { "type": "boolean" },
        "salesReportFrequency": { "type": "string", "enum": ["per_sale", "daily_closing", "manual"] },
        "lastTestStatus": { "type": "string", "maxLength": 240 },
        "lastTestAt": { "type": "string", "maxLength": 60 },
        "updatedAt": { "type": "string", "format": "date-time" }
