    "StoreEmailConfig": {
      "title": "StoreEmailConfig",
      "description": "Private per-store custom SMTP or Resend API configuration for critical stock alerts and sales report email delivery.",
      "type": "object",
      "properties": {
        "storeId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
