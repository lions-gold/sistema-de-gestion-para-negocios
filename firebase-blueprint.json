      "required": [
        "storeId",
        "ownerUid",
        "provider",
        "isEnabled",
        "recipientEmail",
        "alertOnCriticalStock",
        "notifyOnPOS",
        "notifyOnManualAdjustment",
        "alertFrequency",
        "sendSalesReports",
        "salesReportFrequency",
        "updatedAt"
      ]
